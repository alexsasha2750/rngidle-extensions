{
  "manifest_version": 3,
  "name": "RNGidle Shop Helper",
  "version": "1.2.0",
  "version_name": "v1.2-alpha",
  "description": "Preview RNGidle numbers and automatically buy selected shop and Black Market items, from a menu inside the game.",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["alarms", "storage", "scripting"],
  "host_permissions": ["https://rngidle.fun/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "RNGidle Shop Helper",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "content_scripts": [{ "matches": ["https://rngidle.fun/*"], "js": ["content.js", "overlay.js"], "run_at": "document_idle" }],
  "web_accessible_resources": [{ "resources": ["popup.html"], "matches": ["https://rngidle.fun/*"] }]
}
