{
  "manifest_version": 3,
  "name": "RNGidle Shop Helper",
  "version": "1.4.1",
  "version_name": "v1.4.1",
  "description": "Preview RNGidle numbers, buy selected shop and Black Market items, and try Glitch's trials, from a menu inside the game.",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["alarms", "storage", "scripting", "notifications", "downloads"],
  "host_permissions": ["https://rngidle.fun/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "RNGidle Shop Helper",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "commands": {
    "toggle-menu": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Open or close the Shop Helper menu on rngidle.fun"
    }
  },
  "content_scripts": [
    { "matches": ["https://rngidle.fun/*"], "js": ["i18n.js", "sound.js", "calm.js", "content.js", "overlay.js"], "run_at": "document_idle" },
    { "matches": ["https://rngidle.fun/*"], "js": ["potion-numbers.js"], "run_at": "document_idle" },
    { "matches": ["https://rngidle.fun/*"], "js": ["potion-numbers-main.js"], "run_at": "document_idle", "world": "MAIN" }
  ],
  "web_accessible_resources": [{ "resources": ["popup.html", "locales/*/overlay.json"], "matches": ["https://rngidle.fun/*"] }]
}
