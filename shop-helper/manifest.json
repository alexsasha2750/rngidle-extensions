{
  "manifest_version": 3,
  "name": "RNGidle Shop Helper",
  "version": "1.0.0",
  "description": "Automatically buy selected Glim shop items while RNGidle is open.",
  "minimum_chrome_version": "120",
  "permissions": ["alarms", "storage"],
  "host_permissions": ["https://rngidle.fun/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "RNGidle Shop Helper", "default_popup": "popup.html" },
  "content_scripts": [{ "matches": ["https://rngidle.fun/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
